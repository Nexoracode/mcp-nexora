DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nexora
DB_PASSWORD=change-me
DB_NAME=mydb
# Bearer token required on /mcp. Leave empty to disable auth (local testing only).
MCP_API_KEY=
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=15
HOST=127.0.0.1
PORT=8000

# Nexora owner API (nexoraweb /api/owner/*). NEXORA_API_TOKEN must equal OWNER_API_TOKEN in the panel.
NEXORA_API_URL=
NEXORA_API_TOKEN=
# Raw SQL writes (preview_write / execute_write). Keep off; changes should go through the Nexora API.
ENABLE_SQL_WRITE=false
